# =============================================================================
# outo-models.container — podman quadlet unit example
# =============================================================================
#
# Copy this file under /etc/containers/systemd/ (or the user's
# ~/.config/containers/systemd/) under the same name with a
# `.container` extension. systemd auto-detects `*.container` and
# generates an `outo-models.service` systemd unit. Start it with:
# `systemctl --user start outo-models.service`.
#
# Reference: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
#
# This file is for the `stable` flavor. To switch to the dev image,
# change the Image= tag to `dev` (but see AGENTS.md §4 — never deploy
# the dev image to production).

[Unit]
Description=outo-models (self-hostable model hub)
# Depend only on network-online so the container starts after boot
# networking is up. Avoid explicit coupling to other units — keep boot
# ordering minimal.
After=network-online.target
Wants=network-online.target

[Container]
# In production, replace this with an image pushed to the registry.
# `localhost/` is the standard podman convention for locally built
# images without an image-scp step.
Image=localhost/outo-models:stable

# Public ports. The container itself binds 80/443 inside, so this pairs
# with EXPOSE. Publishing these privileged host ports involves two
# separate layers:
#   1) Binding 80/443 INSIDE the container network namespace — grant
#      the capability via AddCapability=NET_BIND_SERVICE (see the
#      SecurityOpt section below).
#   2) Publishing the port on the HOST. On rootless Podman this is done
#      by the rootlessport helper, which lives in the host's network
#      namespace and cannot bind a privileged port while
#      net.ipv4.ip_unprivileged_port_start > 80.
# NET_BIND_SERVICE only covers (1); it does NOT fix (2). A rootless
# deployment publishing privileged host ports needs this one-time command
# on the host:
#   /usr/local/share/outo-models/enable-low-ports.sh 80
PublishPort=80:80
PublishPort=443:443

# Data volume. update.sh / reset.sh use the same name
# ("outo-models-data") — do not change it (a static test enforces the
# name match).
Volume=outo-models-data:/var/lib/outo-models

# Host Podman API socket. `outo-models start` mounts it automatically, but a
# quadlet (or any other) deployment must do it explicitly, otherwise every
# Spaces container SDK (docker/gradio/streamlit) fails. `%t` is the user's
# runtime dir (/run/user/<uid>), i.e. the ROOTLESS podman socket — the
# supported path, because this container runs as uid 1000 and cannot connect
# to a rootful root:root 0660 socket.
Volume=%t/podman/podman.sock:/run/podman/podman.sock:ro
Environment=OUTO_PODMAN_SOCKET=/run/podman/podman.sock

# Auto-update — quadlet delegates the Podman auto-update policy. When
# AutoUpdate=registry is set, `podman-auto-update.timer` detects new
# images and replaces the container without downtime.
AutoUpdate=registry

# -----------------------------------------------------------------------------
# Security options
# -----------------------------------------------------------------------------
# Least privilege. NoNewPrivileges rejects setuid/setgid binaries,
# which blocks any process inside the container from escalating to root
# as an escape route.
SecurityOpt=no-new-privileges:true
SecurityOpt=label=type:container_runtime_t

# NET_BIND_SERVICE grants the capability to bind 80/443 INSIDE the
# container; uncomment the next line to enable it. It has no effect on
# host-side port publication on rootless Podman — for that, run
# /usr/local/share/outo-models/enable-low-ports.sh 80 on the host.
# AddCapability=NET_BIND_SERVICE

# ReadOnly=false: there is no writable area outside the data volume, so
# this is safe. To harden further, set ReadOnly=true and mount /tmp,
# /run, etc. via Tmpfs=.
ReadOnly=false

# Restart policy. `always` means the container is restarted on boot no
# matter how it exited.
Restart=always
RestartSec=10

# Environment variables. Inject secrets via systemd-creds or another
# external secret provider. Add per-environment settings via
# Environment= as needed.
Environment=OUTO_ENV=production

[Service]
# Restart policy for the systemd unit that quadlet generates
# (independent of the container-level policy).
Restart=always

[Install]
WantedBy=default.target
