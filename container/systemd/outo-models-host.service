# outo-models-host.service
#
# ============================================================================
#  OPT-IN host-side bootstrap unit — disabled by default.
# ============================================================================
# This unit automatically opens the host firewall at boot. It is an
# *optional* helper — if you do not need it, leave the unit un-enabled
# (nothing happens). Enable it when:
#   - the host firewall is auto-detected as firewalld / ufw / nftables
#   - you want 80 / 443 opened automatically on every boot
#
# To enable:
#   cp container/systemd/outo-models-host.service /etc/systemd/system/
#   systemctl edit outo-models-host.service   # adjust OUTO_FIREWALL_KIND for your environment
#   systemctl enable --now outo-models-host.service
#
# Dependency: the firewall management daemon (firewalld.service /
# ufw.service / etc.) must be up first. Only `After=` is set — there is
# no `Requires=`, so the unit does not fail when the firewall daemon is
# absent; it logs the attempt regardless of success/failure.
#
# ============================================================================

[Unit]
Description=outo-models host bootstrap (open 80/443 firewall ports at boot)
Documentation=https://github.com/outo-models/outo-models
# After= only sets ordering. Requires= is omitted because some hosts do
# not run firewalld — the unit always attempts the work and never
# blocks boot on failure (Type=oneshot + RemainAfterExit=yes + log
# regardless of success/failure).
After=network-online.target firewalld.service ufw.service nftables.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# ---- Which firewall to open (must override for your environment) ----
# Valid values: firewalld | ufw | nftables | none
#   firewalld  : firewall-cmd --permanent --add-port=80/tcp && reload
#   ufw        : ufw allow 80/tcp
#   nftables   : accumulate rules in the `inet outo_models` table
#   none       : print guidance only and exit 0 (no changes)
Environment=OUTO_FIREWALL_KIND=firewalld

# ---- Helper script path ----
# Assumes the setup wizard copied the script to /opt/outo-models/scripts/.
# If you installed it elsewhere, adjust the ExecStart path accordingly.
ExecStart=/opt/outo-models/scripts/firewall-open.sh ${OUTO_FIREWALL_KIND} 80 443

# Standard logs — inspect with journalctl -u outo-models-host.
StandardOutput=journal
StandardError=journal

[Install]
# Does nothing unless explicitly enabled — the intended opt-in behavior.
WantedBy=multi-user.target
